from collections import deque, defaultdict

class Solution:
    def minJumps(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 1: return 0
        
        max_el = max(nums)
        # 1. Sieve of Eratosthenes
        is_prime = [True] * (max_el + 1)
        is_prime[0] = is_prime[1] = False
        for p in range(2, int(max_el**0.5) + 1):
            if is_prime[p]:
                for i in range(p * p, max_el + 1, p):
                    is_prime[i] = False
        
        # 2. Map value to indices
        val_to_indices = defaultdict(list)
        for idx, val in enumerate(nums):
            val_to_indices[val].append(idx)
            
        # 3. BFS
        queue = deque([0])
        visited = {0}
        seen_primes = set()
        steps = 0
        
        while queue:
            for _ in range(len(queue)):
                curr_idx = queue.popleft()
                
                if curr_idx == n - 1:
                    return steps
                
                # Check neighbors
                for neighbor in [curr_idx - 1, curr_idx + 1]:
                    if 0 <= neighbor < n and neighbor not in visited:
                        visited.add(neighbor)
                        queue.append(neighbor)
                
                # Jump via Prime Multiples
                val = nums[curr_idx]
                if is_prime[val] and val not in seen_primes:
                    for multiple in range(val, max_el + 1, val):
                        if multiple in val_to_indices:
                            for next_idx in val_to_indices[multiple]:
                                if next_idx not in visited:
                                    visited.add(next_idx)
                                    queue.append(next_idx)
                    seen_primes.add(val)
            steps += 1
            
        return -1
